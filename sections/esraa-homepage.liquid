    { "type": "textarea", "id": "editorial_text", "label": "Editorial text", "default": "Embellishment, embroidery, lace, and luminous details come together in statement pieces made for memorable moments." },
    { "type": "url", "id": "editorial_link", "label": "Editorial link" },

    { "type": "header", "content": "Designer story" },
    { "type": "image_picker", "id": "story_image", "label": "Story image" },
    { "type": "text", "id": "story_heading", "label": "Story heading", "default": "A Feminine Vision of Modern Modesty" },
    { "type": "textarea", "id": "story_text", "label": "Story text", "default": "Esraa Fashion Designer creates refined pieces for women who want modest dressing to feel expressive, polished, and unmistakably personal. Every collection balances graceful proportions with rich fabrics and considered detail." },

    { "type": "header", "content": "New arrivals" },
    { "type": "collection", "id": "new_collection", "label": "New arrivals collection" },
    { "type": "range", "id": "new_limit", "min": 4, "max": 8, "step": 1, "default": 4, "label": "Products to show" },

    { "type": "header", "content": "Gallery & social" },
    { "type": "text", "id": "gallery_heading", "label": "Gallery heading", "default": "Styled by Esraa" },
    { "type": "url", "id": "instagram_url", "label": "Instagram URL" },
