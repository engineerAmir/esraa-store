{% comment %}
  Esraa Fashion Designer — Premium Editorial Homepage
  Paste into: sections/esraa-homepage.liquid
  Then add the section to the homepage in the Shopify Theme Editor.
{% endcomment %}

{% liquid
  assign featured_collection = section.settings.featured_collection
  assign new_collection = section.settings.new_collection
%}

<section id="EsraaHome-{{ section.id }}" class="esraa-home">
  <style>
    #EsraaHome-{{ section.id }}{
      --bg: {{ section.settings.bg_color }};
      --surface: {{ section.settings.surface_color }};
      --text: {{ section.settings.text_color }};
      --muted: {{ section.settings.muted_color }};
      --accent: {{ section.settings.accent_color }};
      --accent-soft: {{ section.settings.accent_soft_color }};
      --radius: 22px;
      --radius-sm: 14px;
      --page: min(1440px, calc(100vw - 40px));
      background: var(--bg);
      color: var(--text);
      font-family: var(--font-body-family, "Helvetica Neue", Arial, sans-serif);
      overflow: hidden;
    }

    #EsraaHome-{{ section.id }} *{ box-sizing:border-box; }
    #EsraaHome-{{ section.id }} a{ color:inherit; text-decoration:none; }
    #EsraaHome-{{ section.id }} img{ width:100%; height:100%; display:block; object-fit:cover; }
    #EsraaHome-{{ section.id }} .esraa-shell{ width:var(--page); margin-inline:auto; }
    #EsraaHome-{{ section.id }} .esraa-section{ padding:96px 0; }
    #EsraaHome-{{ section.id }} .esraa-kicker{
      margin:0 0 12px; text-transform:uppercase; letter-spacing:.18em;
      font-size:12px; color:var(--accent); font-weight:700;
    }
    #EsraaHome-{{ section.id }} h1,
    #EsraaHome-{{ section.id }} h2,
    #EsraaHome-{{ section.id }} h3{
      font-family: var(--font-heading-family, Georgia, serif);
      font-weight:500; letter-spacing:-.025em; margin:0;
    }
    #EsraaHome-{{ section.id }} h2{ font-size:clamp(34px,4.3vw,68px); line-height:1.02; }
    #EsraaHome-{{ section.id }} p{ line-height:1.75; }
    #EsraaHome-{{ section.id }} .esraa-btn{
      display:inline-flex; align-items:center; justify-content:center; gap:10px;
      min-height:48px; padding:0 22px; border-radius:999px;
      border:1px solid transparent; background:var(--text); color:var(--bg);
      font-size:14px; font-weight:700; transition:.3s ease;
    }
    #EsraaHome-{{ section.id }} .esraa-btn:hover{ transform:translateY(-2px); background:var(--accent); }
    #EsraaHome-{{ section.id }} .esraa-btn--light{ background:rgba(255,255,255,.92); color:#231f20; }
    #EsraaHome-{{ section.id }} .esraa-btn--outline{
      background:transparent; color:var(--text); border-color:rgba(30,25,25,.22);
    }

    /* Header */
    #EsraaHome-{{ section.id }} .esraa-header{
      position:absolute; inset:0 0 auto 0; z-index:20; height:82px;
      display:flex; align-items:center; color:#fff;
    }
    #EsraaHome-{{ section.id }} .esraa-header__inner{
      width:var(--page); margin:auto; display:grid; grid-template-columns:1fr auto 1fr;
      align-items:center; gap:26px;
    }
    #EsraaHome-{{ section.id }} .esraa-nav,
    #EsraaHome-{{ section.id }} .esraa-actions{ display:flex; gap:24px; align-items:center; }
    #EsraaHome-{{ section.id }} .esraa-nav a,
    #EsraaHome-{{ section.id }} .esraa-actions a{
      font-size:13px; font-weight:600; opacity:.96; transition:.25s ease;
    }
    #EsraaHome-{{ section.id }} .esraa-nav a:hover,
    #EsraaHome-{{ section.id }} .esraa-actions a:hover{ opacity:.68; }
    #EsraaHome-{{ section.id }} .esraa-logo{
      font-family:var(--font-heading-family, Georgia, serif);
      font-size:clamp(22px,2vw,30px); letter-spacing:.02em; text-align:center;
    }
    #EsraaHome-{{ section.id }} .esraa-logo img{ max-height:44px; width:auto; object-fit:contain; }
    #EsraaHome-{{ section.id }} .esraa-actions{ justify-content:flex-end; }
    #EsraaHome-{{ section.id }} .esraa-mobile-menu{ display:none; }

    /* Hero */
    #EsraaHome-{{ section.id }} .esraa-hero{
      position:relative; min-height:92svh; display:flex; align-items:flex-end;
      background:#8a7b74;
    }
    #EsraaHome-{{ section.id }} .esraa-hero__media{ position:absolute; inset:0; }
    #EsraaHome-{{ section.id }} .esraa-hero__media:after{
      content:""; position:absolute; inset:0;
      background:linear-gradient(180deg, rgba(20,15,15,.25) 0%, rgba(20,15,15,.08) 40%, rgba(20,15,15,.62) 100%);
    }
    #EsraaHome-{{ section.id }} .esraa-hero__content{
      position:relative; z-index:2; width:var(--page); margin:0 auto; color:white;
      padding:0 0 clamp(50px,8vw,110px); max-width:1440px;
    }
    #EsraaHome-{{ section.id }} .esraa-hero__content-inner{ max-width:760px; }
    #EsraaHome-{{ section.id }} .esraa-hero h1{
      font-size:clamp(52px,7.8vw,116px); line-height:.92; max-width:900px;
    }
    #EsraaHome-{{ section.id }} .esraa-hero p{ max-width:560px; font-size:16px; opacity:.9; margin:22px 0 28px; }

    /* Category */
    #EsraaHome-{{ section.id }} .esraa-section-head{
      display:flex; justify-content:space-between; align-items:end; gap:30px; margin-bottom:34px;
    }
    #EsraaHome-{{ section.id }} .esraa-section-head p{ max-width:480px; color:var(--muted); margin:0; }
    #EsraaHome-{{ section.id }} .esraa-category-grid{
      display:grid; grid-template-columns:repeat(3,1fr); gap:18px;
    }
    #EsraaHome-{{ section.id }} .esraa-category-card{
      position:relative; min-height:620px; border-radius:var(--radius); overflow:hidden;
      background:var(--surface);
    }
    #EsraaHome-{{ section.id }} .esraa-category-card img{ transition:transform .8s cubic-bezier(.2,.7,.2,1); }
    #EsraaHome-{{ section.id }} .esraa-category-card:hover img{ transform:scale(1.035); }
    #EsraaHome-{{ section.id }} .esraa-category-card:after{
      content:""; position:absolute; inset:0; background:linear-gradient(180deg, transparent 54%, rgba(0,0,0,.52));
    }
    #EsraaHome-{{ section.id }} .esraa-category-card__content{
      position:absolute; z-index:2; left:26px; right:26px; bottom:26px; color:#fff;
      display:flex; justify-content:space-between; align-items:end; gap:16px;
    }
    #EsraaHome-{{ section.id }} .esraa-category-card h3{ font-size:34px; }
    #EsraaHome-{{ section.id }} .esraa-arrow{
      width:44px; height:44px; border-radius:50%; display:grid; place-items:center;
      background:rgba(255,255,255,.92); color:#1d1a1b; font-size:20px; flex:0 0 auto;
    }

    /* Product grids */
    #EsraaHome-{{ section.id }} .esraa-product-grid{
      display:grid; grid-template-columns:repeat(4,1fr); gap:18px;
    }
    #EsraaHome-{{ section.id }} .esraa-product-card{ min-width:0; }
    #EsraaHome-{{ section.id }} .esraa-product-media{
      aspect-ratio:3/4; position:relative; overflow:hidden; border-radius:var(--radius-sm);
      background:#eae2dc;
    }
    #EsraaHome-{{ section.id }} .esraa-product-media img{ transition:transform .55s ease; }
    #EsraaHome-{{ section.id }} .esraa-product-card:hover .esraa-product-media img{ transform:scale(1.025); }
    #EsraaHome-{{ section.id }} .esraa-quick{
      position:absolute; left:14px; right:14px; bottom:14px; opacity:0; transform:translateY(8px);
      transition:.3s ease;
    }
    #EsraaHome-{{ section.id }} .esraa-product-card:hover .esraa-quick{ opacity:1; transform:none; }
    #EsraaHome-{{ section.id }} .esraa-quick button{
      width:100%; min-height:44px; border:0; border-radius:999px;
      background:rgba(255,255,255,.94); color:#201c1d; font-weight:700; cursor:pointer;
    }
    #EsraaHome-{{ section.id }} .esraa-product-info{ padding:15px 2px 0; }
    #EsraaHome-{{ section.id }} .esraa-product-row{ display:flex; justify-content:space-between; gap:16px; align-items:start; }
    #EsraaHome-{{ section.id }} .esraa-product-title{ font-size:15px; font-weight:600; line-height:1.45; }
    #EsraaHome-{{ section.id }} .esraa-price{ white-space:nowrap; font-size:14px; }
    #EsraaHome-{{ section.id }} .esraa-swatches{ display:flex; gap:7px; margin-top:10px; }
    #EsraaHome-{{ section.id }} .esraa-swatch{
      width:15px; height:15px; border-radius:50%; border:1px solid rgba(0,0,0,.14); overflow:hidden;
    }
    #EsraaHome-{{ section.id }} .esraa-swatch img{ width:100%; height:100%; object-fit:cover; }

    /* Editorial statement */
    #EsraaHome-{{ section.id }} .esraa-editorial{
      width:var(--page); margin:0 auto; position:relative; min-height:760px;
      border-radius:calc(var(--radius) + 8px); overflow:hidden; display:flex; align-items:end;
    }
    #EsraaHome-{{ section.id }} .esraa-editorial:after{
      content:""; position:absolute; inset:0;
      background:linear-gradient(180deg, rgba(23,15,18,.05), rgba(23,15,18,.62));
    }
    #EsraaHome-{{ section.id }} .esraa-editorial__content{
      position:relative; z-index:2; color:#fff; padding:60px; max-width:780px;
    }
    #EsraaHome-{{ section.id }} .esraa-editorial__content h2{ font-size:clamp(44px,6vw,86px); }
    #EsraaHome-{{ section.id }} .esraa-editorial__content p{ max-width:560px; opacity:.9; }

    /* Story */
    #EsraaHome-{{ section.id }} .esraa-story{
      display:grid; grid-template-columns:1.05fr .95fr; gap:70px; align-items:center;
    }
    #EsraaHome-{{ section.id }} .esraa-story__media{
      aspect-ratio:4/5; border-radius:var(--radius); overflow:hidden; background:#ddd0c8;
    }
    #EsraaHome-{{ section.id }} .esraa-story__copy{ max-width:560px; }
    #EsraaHome-{{ section.id }} .esraa-story__copy p{ color:var(--muted); font-size:16px; margin:22px 0 28px; }

    /* Gallery */
    #EsraaHome-{{ section.id }} .esraa-gallery{
      display:grid; grid-template-columns:repeat(3,1fr); gap:12px;
    }
    #EsraaHome-{{ section.id }} .esraa-gallery__item{
      aspect-ratio:1/1.18; border-radius:18px; overflow:hidden; position:relative;
    }
    #EsraaHome-{{ section.id }} .esraa-gallery__item img{ transition:transform .55s ease; }
    #EsraaHome-{{ section.id }} .esraa-gallery__item:hover img{ transform:scale(1.035); }

    /* Newsletter */
    #EsraaHome-{{ section.id }} .esraa-newsletter-wrap{
      background:var(--accent-soft); border-radius:30px; padding:72px 30px; text-align:center;
    }
    #EsraaHome-{{ section.id }} .esraa-newsletter-wrap h2{ max-width:780px; margin:auto; }
    #EsraaHome-{{ section.id }} .esraa-newsletter-wrap p{ color:var(--muted); margin:18px auto 24px; }
    #EsraaHome-{{ section.id }} .esraa-newsletter{
      display:flex; max-width:560px; margin:auto; background:rgba(255,255,255,.78);
      padding:6px; border-radius:999px; border:1px solid rgba(50,30,35,.1);
    }
    #EsraaHome-{{ section.id }} .esraa-newsletter input{
      flex:1; border:0; outline:0; background:transparent; padding:0 18px; min-width:0;
      color:var(--text);
    }
    #EsraaHome-{{ section.id }} .esraa-newsletter button{
      min-height:46px; border:0; border-radius:999px; padding:0 22px;
      background:var(--accent); color:#fff; font-weight:700; cursor:pointer;
    }

    /* Footer */
    #EsraaHome-{{ section.id }} .esraa-footer{
      background:#211d1e; color:#f6f1ec; padding:68px 0 28px;
    }
    #EsraaHome-{{ section.id }} .esraa-footer-grid{
      display:grid; grid-template-columns:1.3fr .8fr .8fr .8fr; gap:40px;
    }
    #EsraaHome-{{ section.id }} .esraa-footer h3{ font-size:28px; margin-bottom:16px; }
    #EsraaHome-{{ section.id }} .esraa-footer h4{ margin:0 0 14px; font-size:13px; text-transform:uppercase; letter-spacing:.12em; }
    #EsraaHome-{{ section.id }} .esraa-footer a{ display:block; margin:9px 0; color:rgba(255,255,255,.72); font-size:14px; }
    #EsraaHome-{{ section.id }} .esraa-footer p{ color:rgba(255,255,255,.66); max-width:360px; }
    #EsraaHome-{{ section.id }} .esraa-footer-bottom{
      display:flex; justify-content:space-between; align-items:center; gap:24px;
      border-top:1px solid rgba(255,255,255,.12); margin-top:50px; padding-top:24px;
      font-size:12px; color:rgba(255,255,255,.54);
    }
    #EsraaHome-{{ section.id }} .esraa-payment-icons{ display:flex; gap:8px; flex-wrap:wrap; align-items:center; }
    #EsraaHome-{{ section.id }} .esraa-payment-icons svg{ width:38px; height:auto; }

    /* Animation */
    #EsraaHome-{{ section.id }} .esraa-reveal{
      opacity:0; transform:translateY(24px); transition:opacity .7s ease, transform .7s ease;
    }
    #EsraaHome-{{ section.id }} .esraa-reveal.is-visible{ opacity:1; transform:none; }

    @media (max-width: 1100px){
      #EsraaHome-{{ section.id }}{ --page:min(100% - 28px, 1440px); }
      #EsraaHome-{{ section.id }} .esraa-nav{ display:none; }
      #EsraaHome-{{ section.id }} .esraa-header__inner{ grid-template-columns:1fr auto 1fr; }
      #EsraaHome-{{ section.id }} .esraa-mobile-menu{ display:inline-flex; font-size:13px; }
      #EsraaHome-{{ section.id }} .esraa-actions a:first-child{ display:none; }
      #EsraaHome-{{ section.id }} .esraa-category-card{ min-height:500px; }
      #EsraaHome-{{ section.id }} .esraa-product-grid{ grid-template-columns:repeat(3,1fr); }
      #EsraaHome-{{ section.id }} .esraa-story{ gap:38px; }
    }

    @media (max-width: 749px){
      #EsraaHome-{{ section.id }}{ --page:calc(100vw - 24px); --radius:18px; --radius-sm:13px; }
      #EsraaHome-{{ section.id }} .esraa-section{ padding:64px 0; }
      #EsraaHome-{{ section.id }} .esraa-header{ height:70px; }
      #EsraaHome-{{ section.id }} .esraa-header__inner{ gap:12px; }
      #EsraaHome-{{ section.id }} .esraa-logo{ font-size:19px; }
      #EsraaHome-{{ section.id }} .esraa-logo img{ max-height:34px; }
      #EsraaHome-{{ section.id }} .esraa-actions{ gap:14px; }
      #EsraaHome-{{ section.id }} .esraa-actions a{ font-size:12px; }
      #EsraaHome-{{ section.id }} .esraa-hero{ min-height:84svh; }
      #EsraaHome-{{ section.id }} .esraa-hero h1{ font-size:clamp(46px,15vw,72px); }
      #EsraaHome-{{ section.id }} .esraa-hero__content{ padding-bottom:44px; }
      #EsraaHome-{{ section.id }} .esraa-hero p{ font-size:14px; max-width:90%; }
      #EsraaHome-{{ section.id }} .esraa-section-head{ display:block; margin-bottom:24px; }
      #EsraaHome-{{ section.id }} .esraa-section-head p{ margin-top:14px; }
      #EsraaHome-{{ section.id }} .esraa-category-grid{ grid-template-columns:1fr; }
      #EsraaHome-{{ section.id }} .esraa-category-card{ min-height:460px; }
      #EsraaHome-{{ section.id }} .esraa-category-card h3{ font-size:30px; }
      #EsraaHome-{{ section.id }} .esraa-product-grid{
        grid-template-columns:repeat(2,minmax(0,1fr)); gap:22px 10px;
      }
      #EsraaHome-{{ section.id }} .esraa-product-title{ font-size:13px; }
      #EsraaHome-{{ section.id }} .esraa-price{ font-size:12px; }
      #EsraaHome-{{ section.id }} .esraa-quick{ display:none; }
      #EsraaHome-{{ section.id }} .esraa-editorial{ min-height:620px; }
      #EsraaHome-{{ section.id }} .esraa-editorial__content{ padding:30px 24px; }
      #EsraaHome-{{ section.id }} .esraa-editorial__content h2{ font-size:48px; }
      #EsraaHome-{{ section.id }} .esraa-story{ grid-template-columns:1fr; gap:30px; }
      #EsraaHome-{{ section.id }} .esraa-story__copy{ padding:0 4px; }
      #EsraaHome-{{ section.id }} .esraa-gallery{ grid-template-columns:repeat(2,1fr); gap:8px; }
      #EsraaHome-{{ section.id }} .esraa-newsletter-wrap{ padding:52px 18px; border-radius:22px; }
      #EsraaHome-{{ section.id }} .esraa-newsletter{ border-radius:18px; display:grid; gap:8px; padding:8px; }
      #EsraaHome-{{ section.id }} .esraa-newsletter input{ min-height:48px; }
      #EsraaHome-{{ section.id }} .esraa-newsletter button{ width:100%; }
      #EsraaHome-{{ section.id }} .esraa-footer-grid{ grid-template-columns:1fr 1fr; }
      #EsraaHome-{{ section.id }} .esraa-footer-grid > div:first-child{ grid-column:1/-1; }
      #EsraaHome-{{ section.id }} .esraa-footer-bottom{ display:block; }
      #EsraaHome-{{ section.id }} .esraa-payment-icons{ margin-top:16px; }
    }

    @media (prefers-reduced-motion: reduce){
      #EsraaHome-{{ section.id }} *, #EsraaHome-{{ section.id }} *:before, #EsraaHome-{{ section.id }} *:after{
        scroll-behavior:auto !important; transition:none !important; animation:none !important;
      }
      #EsraaHome-{{ section.id }} .esraa-reveal{ opacity:1; transform:none; }
    }
  </style>

  <!-- Transparent header -->
  <header class="esraa-header">
    <div class="esraa-header__inner">
      <div>
        <button class="esraa-mobile-menu" type="button" aria-label="Open menu" style="background:none;border:0;color:inherit;padding:0;">Menu</button>
        <nav class="esraa-nav" aria-label="Primary">
          <a href="{{ section.settings.shop_link | default: routes.all_products_collection_url }}">Shop</a>
          <a href="{{ section.settings.shirts_link }}">Shirts</a>
          <a href="{{ section.settings.suits_link }}">Suits</a>
          <a href="{{ section.settings.new_link }}">New Arrivals</a>
          <a href="{{ section.settings.about_link }}">About</a>
        </nav>
      </div>

      <a class="esraa-logo" href="{{ routes.root_url }}">
        {% if section.settings.logo != blank %}
          {{ section.settings.logo | image_url: width: 300 | image_tag: loading: 'eager', alt: shop.name }}
        {% else %}
          {{ section.settings.logo_text | default: 'Esraa Fashion Designer' }}
        {% endif %}
      </a>

      <div class="esraa-actions">
        <a href="{{ routes.search_url }}">Search</a>
        <a href="{{ routes.cart_url }}">Cart ({{ cart.item_count }})</a>
      </div>
    </div>
  </header>

  <!-- Hero -->
  <div class="esraa-hero">
    <div class="esraa-hero__media">
      {% if section.settings.hero_image != blank %}
        {{ section.settings.hero_image | image_url: width: 2200 | image_tag: loading: 'eager', fetchpriority: 'high', alt: section.settings.hero_heading }}
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {% endif %}
    </div>
    <div class="esraa-hero__content">
      <div class="esraa-hero__content-inner esraa-reveal">
        <p class="esraa-kicker" style="color:#fff;">{{ section.settings.hero_kicker }}</p>
        <h1>{{ section.settings.hero_heading }}</h1>
        <p>{{ section.settings.hero_text }}</p>
        <a class="esraa-btn esraa-btn--light" href="{{ section.settings.hero_link | default: routes.all_products_collection_url }}">
          {{ section.settings.hero_button }}
        </a>
      </div>
    </div>
  </div>

  <!-- Categories -->
  <div class="esraa-section">
    <div class="esraa-shell">
      <div class="esraa-section-head esraa-reveal">
        <div>
          <p class="esraa-kicker">Curated wardrobe</p>
          <h2>Shop by Category</h2>
        </div>
        <p>Refined modest silhouettes, thoughtful details, and elegant textures designed for effortless everyday dressing and special occasions.</p>
      </div>

      <div class="esraa-category-grid">
        {% for i in (1..3) %}
          {% liquid
            case i
              when 1
                assign category_title = section.settings.cat1_title
                assign category_image = section.settings.cat1_image
                assign category_link = section.settings.cat1_link
              when 2
                assign category_title = section.settings.cat2_title
                assign category_image = section.settings.cat2_image
                assign category_link = section.settings.cat2_link
              when 3
                assign category_title = section.settings.cat3_title
                assign category_image = section.settings.cat3_image
                assign category_link = section.settings.cat3_link
            endcase
          %}
          <a class="esraa-category-card esraa-reveal" href="{{ category_link }}">
            {% if category_image != blank %}
              {{ category_image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: category_title }}
            {% else %}
              {{ 'collection-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}
            <div class="esraa-category-card__content">
              <h3>{{ category_title }}</h3>
              <span class="esraa-arrow" aria-hidden="true">↗</span>
            </div>
          </a>
        {% endfor %}
      </div>
    </div>
  </div>

  <!-- Featured collection -->
  {% if featured_collection != blank %}
    <div class="esraa-section" style="padding-top:20px;">
      <div class="esraa-shell">
        <div class="esraa-section-head esraa-reveal">
          <div>
            <p class="esraa-kicker">Editor’s selection</p>
            <h2>{{ section.settings.featured_heading }}</h2>
          </div>
          <a class="esraa-btn esraa-btn--outline" href="{{ featured_collection.url }}">View all</a>
        </div>

        <div class="esraa-product-grid">
          {% for product in featured_collection.products limit: section.settings.featured_limit %}
            {% assign first_variant = product.selected_or_first_available_variant %}
            <article class="esraa-product-card esraa-reveal">
              <a href="{{ product.url }}" class="esraa-product-media">
                {% if product.featured_image %}
                  {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: product.title }}
                {% endif %}
                {% if product.available %}
                  <div class="esraa-quick">
                    {% assign featured_form_id = 'FeaturedForm-' | append: section.id | append: '-' | append: product.id %}
                    {% form 'product', product, id: featured_form_id %}
                      <input type="hidden" name="id" value="{{ first_variant.id }}">
                      <button type="submit" name="add">Quick add</button>
                    {% endform %}
                  </div>
                {% endif %}
              </a>
              <div class="esraa-product-info">
                <div class="esraa-product-row">
                  <a class="esraa-product-title" href="{{ product.url }}">{{ product.title }}</a>
                  <div class="esraa-price">{{ product.price | money }}</div>
                </div>
                {% for option in product.options_with_values %}
                  {% assign option_down = option.name | downcase %}
                  {% if option_down contains 'color' or option_down contains 'colour' %}
                    <div class="esraa-swatches" aria-label="{{ option.name }}">
                      {% for value in option.values limit: 5 %}
                        <span class="esraa-swatch" title="{{ value | escape }}" style="background:{{ value | escape }};"></span>
                      {% endfor %}
                    </div>
                    {% break %}
                  {% endif %}
                {% endfor %}
              </div>
            </article>
          {% endfor %}
        </div>
      </div>
    </div>
  {% endif %}

  <!-- Editorial -->
  <div class="esraa-section" style="padding-top:30px;">
    <div class="esraa-editorial esraa-reveal">
      {% if section.settings.editorial_image != blank %}
        {{ section.settings.editorial_image | image_url: width: 2200 | image_tag: loading: 'lazy', alt: section.settings.editorial_heading }}
      {% else %}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
      {% endif %}
      <div class="esraa-editorial__content">
        <p class="esraa-kicker" style="color:#fff;">Statement dressing</p>
        <h2>{{ section.settings.editorial_heading }}</h2>
        <p>{{ section.settings.editorial_text }}</p>
        <a class="esraa-btn esraa-btn--light" href="{{ section.settings.editorial_link }}">Explore statement pieces</a>
      </div>
    </div>
  </div>

  <!-- Designer story -->
  <div class="esraa-section">
    <div class="esraa-shell esraa-story">
      <div class="esraa-story__media esraa-reveal">
        {% if section.settings.story_image != blank %}
          {{ section.settings.story_image | image_url: width: 1400 | image_tag: loading: 'lazy', alt: section.settings.story_heading }}
        {% else %}
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}
      </div>
      <div class="esraa-story__copy esraa-reveal">
        <p class="esraa-kicker">The designer</p>
        <h2>{{ section.settings.story_heading }}</h2>
        <p>{{ section.settings.story_text }}</p>
        <a class="esraa-btn esraa-btn--outline" href="{{ section.settings.about_link }}">Discover Esraa’s vision</a>
      </div>
    </div>
  </div>

  <!-- New Arrivals -->
  {% if new_collection != blank %}
    <div class="esraa-section" style="padding-top:20px;">
      <div class="esraa-shell">
        <div class="esraa-section-head esraa-reveal">
          <div>
            <p class="esraa-kicker">Just in</p>
            <h2>New Arrivals</h2>
          </div>
          <a class="esraa-btn esraa-btn--outline" href="{{ new_collection.url }}">Shop new arrivals</a>
        </div>
        <div class="esraa-product-grid">
          {% for product in new_collection.products limit: section.settings.new_limit %}
            {% assign first_variant = product.selected_or_first_available_variant %}
            <article class="esraa-product-card esraa-reveal">
              <a href="{{ product.url }}" class="esraa-product-media">
                {% if product.featured_image %}
                  {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: product.title }}
                {% endif %}
                {% if product.available %}
                  <div class="esraa-quick">
                    {% assign new_form_id = 'NewForm-' | append: section.id | append: '-' | append: product.id %}
                    {% form 'product', product, id: new_form_id %}
                      <input type="hidden" name="id" value="{{ first_variant.id }}">
                      <button type="submit" name="add">Quick add</button>
                    {% endform %}
                  </div>
                {% endif %}
              </a>
              <div class="esraa-product-info">
                <div class="esraa-product-row">
                  <a class="esraa-product-title" href="{{ product.url }}">{{ product.title }}</a>
                  <div class="esraa-price">{{ product.price | money }}</div>
                </div>
                {% for option in product.options_with_values %}
                  {% assign option_down = option.name | downcase %}
                  {% if option_down contains 'color' or option_down contains 'colour' %}
                    <div class="esraa-swatches" aria-label="{{ option.name }}">
                      {% for value in option.values limit: 5 %}
                        <span class="esraa-swatch" title="{{ value | escape }}" style="background:{{ value | escape }};"></span>
                      {% endfor %}
                    </div>
                    {% break %}
                  {% endif %}
                {% endfor %}
              </div>
            </article>
          {% endfor %}
        </div>
      </div>
    </div>
  {% endif %}

  <!-- Instagram-inspired gallery -->
  <div class="esraa-section">
    <div class="esraa-shell">
      <div class="esraa-section-head esraa-reveal">
        <div>
          <p class="esraa-kicker">The Esraa edit</p>
          <h2>{{ section.settings.gallery_heading }}</h2>
        </div>
        {% if section.settings.instagram_url != blank %}
          <a class="esraa-btn esraa-btn--outline" href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener">Instagram</a>
        {% endif %}
      </div>

      <div class="esraa-gallery">
        {% for block in section.blocks %}
          {% if block.type == 'gallery_image' %}
            <a class="esraa-gallery__item esraa-reveal" href="{{ block.settings.link | default: section.settings.instagram_url }}" {{ block.shopify_attributes }}>
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: block.settings.alt }}
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {% endif %}
            </a>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>

  <!-- Newsletter -->
  <div class="esraa-section" style="padding-top:20px;">
    <div class="esraa-shell">
      <div class="esraa-newsletter-wrap esraa-reveal">
        <p class="esraa-kicker">Private edit</p>
        <h2>Discover the latest from Esraa.</h2>
        <p>New collections, styling notes, and exclusive releases—delivered thoughtfully.</p>
        {% form 'customer', class: 'esraa-newsletter' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input type="email" name="contact[email]" value="{{ form.email }}" placeholder="Your email address" required aria-label="Email address">
          <button type="submit">Subscribe</button>
        {% endform %}
      </div>
    </div>
  </div>

  <!-- Footer -->
  <footer class="esraa-footer">
    <div class="esraa-shell">
      <div class="esraa-footer-grid">
        <div>
          <h3>{{ section.settings.logo_text | default: 'Esraa Fashion Designer' }}</h3>
          <p>Elegant modest fashion with a designer eye for detail, texture, femininity, and beautifully balanced silhouettes.</p>
        </div>
        <div>
          <h4>Shop</h4>
          <a href="{{ section.settings.shop_link | default: routes.all_products_collection_url }}">All pieces</a>
          <a href="{{ section.settings.shirts_link }}">Shirts</a>
          <a href="{{ section.settings.suits_link }}">Suits</a>
          <a href="{{ section.settings.new_link }}">New Arrivals</a>
        </div>
        <div>
          <h4>Customer care</h4>
          <a href="/pages/contact">Contact</a>
          <a href="/policies/shipping-policy">Shipping</a>
          <a href="/policies/refund-policy">Returns</a>
          <a href="/policies/privacy-policy">Privacy</a>
        </div>
        <div>
          <h4>Follow</h4>
          {% if section.settings.instagram_url != blank %}<a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener">Instagram</a>{% endif %}
          {% if section.settings.tiktok_url != blank %}<a href="{{ section.settings.tiktok_url }}" target="_blank" rel="noopener">TikTok</a>{% endif %}
          {% if section.settings.facebook_url != blank %}<a href="{{ section.settings.facebook_url }}" target="_blank" rel="noopener">Facebook</a>{% endif %}
        </div>
      </div>

      <div class="esraa-footer-bottom">
        <div>© {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</div>
        <div class="esraa-payment-icons">
          {% for type in shop.enabled_payment_types %}
            {{ type | payment_type_svg_tag }}
          {% endfor %}
        </div>
      </div>
    </div>
  </footer>

  <script>
    (() => {
      const root = document.getElementById('EsraaHome-{{ section.id }}');
      if (!root) return;

      const items = root.querySelectorAll('.esraa-reveal');
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.12 });
        items.forEach((el) => observer.observe(el));
      } else {
        items.forEach((el) => el.classList.add('is-visible'));
      }
    })();
  </script>
</section>

{% schema %}
