{% doc %}
  @prompt
    Create an Instagram-inspired editorial fashion gallery for “Esraa Fashion Designer”.
    
    Small label:
    “THE ESRAA EDIT”
    
    Heading:
    “Styled by Esraa”
    
    Use high-quality fashion photography inspired by the brand’s Instagram content.
    
    Layout:
    Desktop: 3 columns.
    Mobile: 2 columns.
    
    Images should have consistent proportions with subtle rounded corners.
    
    Use minimal gaps to create a premium fashion-editorial gallery.
    
    On hover:
    
    * Slight image zoom.
    * Optional subtle Instagram icon overlay.
    
    Allow 6–9 images to be uploaded manually through Shopify blocks.
    
    Each image should optionally support a custom link.
    
    Add an optional “Instagram” button beside the section heading.
    
    Do not embed a heavy third-party Instagram feed. Prioritize speed, clean design, and photography.
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-editorial-gallery-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: {{ block.settings.text_color }};
  }

  .ai-editorial-gallery__header-{{ ai_gen_id }} {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 24px;
  }

  .ai-editorial-gallery__label-{{ ai_gen_id }} {
    display: block;
    margin: 0 0 8px;
    font-size: 11px;
    line-height: 1.2;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: {{ block.settings.label_color }};
  }

  .ai-editorial-gallery__heading-{{ ai_gen_id }} {
    margin: 0;
    font-family: {{ block.settings.heading_font.family }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .ai-editorial-gallery__button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
    padding: 11px 16px;
    border: 1px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_radius }}px;
    color: {{ block.settings.button_text_color }};
    background: {{ block.settings.button_background }};
    font-size: 12px;
    text-decoration: none;
    line-height: 1;
  }

  .ai-editorial-gallery__button-{{ ai_gen_id }}:focus-visible,
  .ai-editorial-gallery__link-{{ ai_gen_id }}:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  .ai-editorial-gallery__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: {{ block.settings.gap }}px;
  }

  .ai-editorial-gallery__item-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border-radius: {{ block.settings.image_radius }}px;
    background: #f2f2f2;
  }

  .ai-editorial-gallery__link-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .ai-editorial-gallery__image-{{ ai_gen_id }},
  .ai-editorial-gallery__placeholder-{{ ai_gen_id }} svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-editorial-gallery__image-{{ ai_gen_id }} {
    transition: transform 280ms ease;
  }

  .ai-editorial-gallery__item-{{ ai_gen_id }}:hover .ai-editorial-gallery__image-{{ ai_gen_id }},
  .ai-editorial-gallery__item-{{ ai_gen_id }}:focus-within .ai-editorial-gallery__image-{{ ai_gen_id }} {
    transform: scale(1.04);
  }

  .ai-editorial-gallery__overlay-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    opacity: 0;
    color: #ffffff;
    background: rgba(0, 0, 0, 0.2);
    transition: opacity 180ms ease;
    pointer-events: none;
  }

  .ai-editorial-gallery__item-{{ ai_gen_id }}:hover .ai-editorial-gallery__overlay-{{ ai_gen_id }},
  .ai-editorial-gallery__item-{{ ai_gen_id }}:focus-within .ai-editorial-gallery__overlay-{{ ai_gen_id }} {
    opacity: 1;
  }

  .ai-editorial-gallery__overlay-{{ ai_gen_id }} svg {
    width: 25px;
    height: 25px;
  }

  .ai-editorial-gallery__empty-{{ ai_gen_id }} {
    display: flex;
    height: 100%;
    align-items: end;
    justify-content: center;
    padding: 18px;
    color: #555555;
    font-size: 12px;
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .ai-editorial-gallery__header-{{ ai_gen_id }} {
      align-items: start;
      margin-bottom: 16px;
    }

    .ai-editorial-gallery__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-editorial-gallery__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
{% endstyle %}

<aside class="ai-editorial-gallery-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-editorial-gallery__header-{{ ai_gen_id }}">
    <div>
      <span class="ai-editorial-gallery__label-{{ ai_gen_id }}">{{ block.settings.label }}</span>
      <h2 class="ai-editorial-gallery__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    </div>
    {% if block.settings.show_button and block.settings.instagram_link != blank %}
      <a class="ai-editorial-gallery__button-{{ ai_gen_id }}" href="{{ block.settings.instagram_link }}" target="_blank" rel="noopener" aria-label="{{ block.settings.button_label }}">
        <span>{{ block.settings.button_label }}</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".7" fill="currentColor" stroke="none"/></svg>
      </a>
    {% endif %}
  </div>

  <div class="ai-editorial-gallery__grid-{{ ai_gen_id }}">
    {% for i in (1..9) %}
      {% liquid
        assign image_key = 'image_' | append: i
        assign link_key = 'link_' | append: i
        assign image = block.settings[image_key]
        assign link = block.settings[link_key]
      %}
      {% if image != blank %}
        <div class="ai-editorial-gallery__item-{{ ai_gen_id }}">
          {% if link != blank %}<a class="ai-editorial-gallery__link-{{ ai_gen_id }}" href="{{ link }}">{% endif %}
            <img class="ai-editorial-gallery__image-{{ ai_gen_id }}" src="{{ image | image_url: width: 1200 }}" alt="{{ image.alt | escape }}" loading="lazy" width="{{ image.width }}" height="{{ image.height }}">
            {% if block.settings.show_overlay %}<span class="ai-editorial-gallery__overlay-{{ ai_gen_id }}" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".7" fill="currentColor" stroke="none"/></svg></span>{% endif %}
          {% if link != blank %}</a>{% endif %}
        </div>
      {% endif %}
    {% endfor %}
    {% if block.settings.image_1 == blank and block.settings.image_2 == blank and block.settings.image_3 == blank and block.settings.image_4 == blank and block.settings.image_5 == blank and block.settings.image_6 == blank and block.settings.image_7 == blank and block.settings.image_8 == blank and block.settings.image_9 == blank %}
      <div class="ai-editorial-gallery__item-{{ ai_gen_id }}"><div class="ai-editorial-gallery__placeholder-{{ ai_gen_id }}">{{ 'image' | placeholder_svg_tag }}<span class="ai-editorial-gallery__empty-{{ ai_gen_id }}">Add your fashion photography to begin the edit.</span></div></div>
    {% endif %}
  </div>
</aside>

{% schema %}
{
  "name": "Editorial fashion gallery",
  "settings": [
    {"type":"header","content":"Content"},
    {"type":"text","id":"label","label":"Small label","default":"THE ESRAA EDIT"},
    {"type":"text","id":"heading","label":"Heading","default":"Styled by Esraa"},
    {"type":"checkbox","id":"show_button","label":"Show Instagram button","default":true},
    {"type":"text","id":"button_label","label":"Button label","default":"Instagram"},
    {"type":"url","id":"instagram_link","label":"Instagram link"},
    {"type":"header","content":"Gallery"},
    {"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},
    {"type":"range","id":"gap","label":"Gap","min":0,"max":24,"step":2,"unit":"px","default":4},
    {"type":"range","id":"image_radius","label":"Image radius","min":0,"max":24,"step":2,"unit":"px","default":6},
    {"type":"checkbox","id":"show_overlay","label":"Show Instagram overlay","default":true},
    {"type":"header","content":"Images 1–3"},
    {"type":"image_picker","id":"image_1","label":"Image 1"}, {"type":"url","id":"link_1","label":"Link 1"},
    {"type":"image_picker","id":"image_2","label":"Image 2"}, {"type":"url","id":"link_2","label":"Link 2"},
    {"type":"image_picker","id":"image_3","label":"Image 3"}, {"type":"url","id":"link_3","label":"Link 3"},
    {"type":"header","content":"Images 4–6"},
    {"type":"image_picker","id":"image_4","label":"Image 4"}, {"type":"url","id":"link_4","label":"Link 4"},
    {"type":"image_picker","id":"image_5","label":"Image 5"}, {"type":"url","id":"link_5","label":"Link 5"},
    {"type":"image_picker","id":"image_6","label":"Image 6"}, {"type":"url","id":"link_6","label":"Link 6"},
    {"type":"header","content":"Images 7–9"},
    {"type":"image_picker","id":"image_7","label":"Image 7"}, {"type":"url","id":"link_7","label":"Link 7"},
    {"type":"image_picker","id":"image_8","label":"Image 8"}, {"type":"url","id":"link_8","label":"Link 8"},
    {"type":"image_picker","id":"image_9","label":"Image 9"}, {"type":"url","id":"link_9","label":"Link 9"},
    {"type":"header","content":"Style"},
    {"type":"font_picker","id":"heading_font","label":"Heading font","default":"inter_n7"},
    {"type":"range","id":"heading_size","label":"Heading size","min":20,"max":72,"step":4,"unit":"px","default":48},
    {"type":"color","id":"text_color","label":"Text","default":"#000000"},
    {"type":"color","id":"label_color","label":"Label","default":"#333333"},
    {"type":"color","id":"button_background","label":"Button background","default":"#FFFFFF"},
    {"type":"color","id":"button_text_color","label":"Button text","default":"#000000"},
    {"type":"color","id":"button_border_color","label":"Button border","default":"#000000"},
    {"type":"range","id":"button_radius","label":"Button radius","min":0,"max":24,"step":2,"unit":"px","default":14}
  ],
  "presets": [{"name":"Editorial fashion gallery"}],
  "tag": null,
  "class": "editorial-fashion-gallery"
}
{% endschema %}