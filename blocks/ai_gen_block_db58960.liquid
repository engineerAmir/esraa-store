{% doc %}
  @prompt
    new ariavels collection 
    no  padding no margens 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-new-arrivals-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0;
    padding: 0;
    color: {{ block.settings.text_color }};
  }

  .ai-new-arrivals-{{ ai_gen_id }}__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin: 0;
    padding: 0 0 20px;
  }

  .ai-new-arrivals-{{ ai_gen_id }}__title {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-family: {{ block.settings.heading_font.family }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.1;
  }

  .ai-new-arrivals-{{ ai_gen_id }}__link {
    color: {{ block.settings.text_color }};
    font-size: 14px;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .ai-new-arrivals-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, minmax(0, 1fr));
    gap: {{ block.settings.grid_gap }}px;
    margin: 0;
    padding: 0;
  }

  .ai-new-arrivals-{{ ai_gen_id }}__card {
    min-width: 0;
    margin: 0;
    padding: 0;
  }

  .ai-new-arrivals-{{ ai_gen_id }}__media {
    display: block;
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: {{ block.settings.image_background }};
    margin: 0;
    padding: 0;
  }

  .ai-new-arrivals-{{ ai_gen_id }}__media img,
  .ai-new-arrivals-{{ ai_gen_id }}__media svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-new-arrivals-{{ ai_gen_id }}__info {
    margin: 0;
    padding: 10px 0 0;
  }

  .ai-new-arrivals-{{ ai_gen_id }}__product-title {
    display: block;
    margin: 0 0 5px;
    color: {{ block.settings.text_color }};
    font-size: 15px;
    line-height: 1.3;
    text-decoration: none;
  }

  .ai-new-arrivals-{{ ai_gen_id }}__price {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-size: 14px;
    line-height: 1.3;
  }

  .ai-new-arrivals-{{ ai_gen_id }}__empty {
    margin: 0;
    padding: 20px 0;
    color: {{ block.settings.text_color }};
    font-size: 14px;
  }

  @media screen and (max-width: 749px) {
    .ai-new-arrivals-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-new-arrivals-{{ ai_gen_id }}__header {
      padding-bottom: 14px;
    }

    .ai-new-arrivals-{{ ai_gen_id }}__title {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-new-arrivals-{{ ai_gen_id }}__grid {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, minmax(0, 1fr));
      gap: {{ block.settings.grid_gap | times: 0.75 }}px;
    }
  }
{% endstyle %}

<div class="ai-new-arrivals-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-new-arrivals-{{ ai_gen_id }}__header">
    <h2 class="ai-new-arrivals-{{ ai_gen_id }}__title">{{ block.settings.heading }}</h2>
    {% if block.settings.collection != blank and block.settings.show_view_all %}
      <a class="ai-new-arrivals-{{ ai_gen_id }}__link" href="{{ block.settings.collection.url }}">{{ block.settings.view_all_label }}</a>
    {% endif %}
  </div>

  {% if block.settings.collection != blank and block.settings.collection.products_count > 0 %}
    <div class="ai-new-arrivals-{{ ai_gen_id }}__grid">
      {% for product in block.settings.collection.products limit: block.settings.products_to_show %}
        <article class="ai-new-arrivals-{{ ai_gen_id }}__card">
          <a class="ai-new-arrivals-{{ ai_gen_id }}__media" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
            {% if product.featured_image %}
              <img src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}">
            {% else %}
              <div class="ai-new-arrivals-{{ ai_gen_id }}__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>
            {% endif %}
          </a>
          <div class="ai-new-arrivals-{{ ai_gen_id }}__info">
            <a class="ai-new-arrivals-{{ ai_gen_id }}__product-title" href="{{ product.url }}">{{ product.title }}</a>
            <p class="ai-new-arrivals-{{ ai_gen_id }}__price">{{ product.price | money }}</p>
          </div>
        </article>
      {% endfor %}
    </div>
  {% else %}
    <p class="ai-new-arrivals-{{ ai_gen_id }}__empty">Choose a collection to show your new arrivals.</p>
  {% endif %}
</div>

{% schema %}
{
  "name": "New arrivals collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New arrivals"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Grid gap",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show view all link",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all label",
      "default": "View all"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "cormorant_n4"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 18,
      "max": 56,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#2A2526"
    },
    {
      "type": "color",
      "id": "image_background",
      "label": "Image background",
      "default": "#E9DADB"
    }
  ],
  "presets": [
    {
      "name": "New arrivals collection"
    }
  ],
  "tag": null,
  "class": "new-arrivals-collection"
}
{% endschema %}