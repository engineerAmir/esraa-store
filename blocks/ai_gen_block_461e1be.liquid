e":"8","label":"Moderate"},{"value":"12","label":"Expressive"}],"default":"4"},{"type":"range","id":"animation_distance","label":"Reveal distance","min":10,"max":80,"step":10,"unit":"px","default":30},{"type":"header","content":"Style"},{"type":"font_picker","id":"heading_font","label":"Heading font","default":"anonymous_pro_n4"},{"type":"range","id":"heading_size","label":"Heading size","min":28,"max":72,"step":4,"unit":"px","default":48},{"type":"range","id":"mobile_heading_size","label":"Mobile heading size","min":24,"max":48,"step":4,"unit":"px","default":32},{"type":"range","id":"corner_radius","label":"Image corner radius","min":0,"max":32,"step":4,"unit":"px","default":12},{"type":"range","id":"button_radius","label":"Button corner radius","min":0,"max":24,"step":4,"unit":"px","default":4},{"type":"color","id":"background_color","label":"Background","default":"#F6F0E9"},{"type":"color","id":"text_color","label":"Text","default":"#292525"},{"type":"color","id":"accent_color","label":"Accent","default":"#6B263A"}],"presets":[{"name":"Mother and daughter story"}],"tag":null,"class":"editorial-bond-block"}
