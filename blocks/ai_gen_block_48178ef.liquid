{% doc %}
  @prompt
    Create a premium transparent Shopify header for “Esraa Fashion Designer”, a women’s modest fashion brand.
    
    Design:
    
    * Elegant luxury fashion boutique style.
    * Transparent header positioned over the hero image.
    * Logo centered or elegantly positioned.
    * Navigation: Shop, Shirts, Suits, New Arrivals, About.
    * Add Search and Cart icons.
    * Use clean, refined typography.
    * White text when displayed over the hero.
    * Add a subtle background/blur when the user scrolls.
    * Smooth hover animations.
    * Generous spacing.
    * Fully responsive.
    
    Mobile:
    
    * Logo clearly visible.
    * Hamburger menu.
    * Search and Cart icons.
    * Clean compact layout.
    * Avoid a bulky mobile header.
    
    The overall feeling should be feminine, sophisticated, minimal, and luxurious.
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-luxury-header-{{ ai_gen_id }}{position:absolute;inset:0 0 auto;z-index:20;display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;color:{{ block.settings.overlay_text_color }};transition:background-color 240ms ease,color 240ms ease,box-shadow 240ms ease,backdrop-filter 240ms ease}.ai-luxury-header-{{ ai_gen_id }}.is-scrolled{position:fixed;background:{{ block.settings.scrolled_background_color }};color:{{ block.settings.scrolled_text_color }};box-shadow:0 8px 30px rgba(0,0,0,.08);backdrop-filter:blur(14px)}.ai-luxury-header-{{ ai_gen_id }}__inner{width:100%;min-height:{{ block.settings.header_height }}px;padding:0 clamp(20px,4vw,64px);display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:28px}.ai-luxury-header-{{ ai_gen_id }}__brand{display:inline-flex;align-items:center;justify-self:start;color:inherit;text-decoration:none;max-width:240px}.ai-luxury-header-{{ ai_gen_id }}__logo{display:block;width:auto;max-width:210px;height:{{ block.settings.logo_height }}px;object-fit:contain}.ai-luxury-header-{{ ai_gen_id }}__wordmark{font-family:{{ block.settings.heading_font.family }},sans-serif;font-size:{{ block.settings.wordmark_size }}px;letter-spacing:.12em;line-height:1.1;text-transform:uppercase}.ai-luxury-header-{{ ai_gen_id }}__nav{display:flex;align-items:center;justify-content:center;gap:clamp(18px,2.4vw,38px)}.ai-luxury-header-{{ ai_gen_id }}__link,.ai-luxury-header-{{ ai_gen_id }}__icon-link,.ai-luxury-header-{{ ai_gen_id }}__menu-button{color:inherit}.ai-luxury-header-{{ ai_gen_id }}__link{position:relative;padding:8px 0;font-family:{{ block.settings.body_font.family }},sans-serif;font-size:{{ block.settings.nav_size }}px;letter-spacing:.08em;text-decoration:none;text-transform:uppercase;white-space:nowrap}.ai-luxury-header-{{ ai_gen_id }}__link:after{content:'';position:absolute;right:0;bottom:2px;left:0;height:1px;background:currentColor;transform:scaleX(0);transform-origin:right;transition:transform 220ms ease}.ai-luxury-header-{{ ai_gen_id }}__link:hover:after,.ai-luxury-header-{{ ai_gen_id }}__link:focus-visible:after{transform:scaleX(1);transform-origin:left}.ai-luxury-header-{{ ai_gen_id }}__actions{display:flex;align-items:center;justify-content:flex-end;gap:18px}.ai-luxury-header-{{ ai_gen_id }}__icon-link,.ai-luxury-header-{{ ai_gen_id }}__menu-button{display:inline-flex;align-items:center;justify-content:center;width:28px;height:36px;padding:0;border:0;background:transparent;cursor:pointer}.ai-luxury-header-{{ ai_gen_id }}__icon-link svg,.ai-luxury-header-{{ ai_gen_id }}__menu-button svg{width:19px;height:19px;stroke:currentColor;fill:none;stroke-width:1.5}.ai-luxury-header-{{ ai_gen_id }}__menu-button{display:none}.ai-luxury-header-{{ ai_gen_id }}__mobile-panel{display:none}@media screen and (max-width:899px){.ai-luxury-header-{{ ai_gen_id }}__inner{min-height:{{ block.settings.mobile_header_height }}px;padding:0 20px;grid-template-columns:1fr auto 1fr;gap:12px}.ai-luxury-header-{{ ai_gen_id }}__brand{justify-self:center;grid-column:2;grid-row:1}.ai-luxury-header-{{ ai_gen_id }}__logo{height:{{ block.settings.mobile_logo_height }}px;max-width:150px}.ai-luxury-header-{{ ai_gen_id }}__wordmark{font-size:{{ block.settings.mobile_wordmark_size }}px;text-align:center}.ai-luxury-header-{{ ai_gen_id }}__nav{display:none}.ai-luxury-header-{{ ai_gen_id }}__actions{grid-column:3;grid-row:1;gap:8px}.ai-luxury-header-{{ ai_gen_id }}__menu-button{display:inline-flex;grid-column:1;grid-row:1;justify-self:start}.ai-luxury-header-{{ ai_gen_id }}__mobile-panel{position:absolute;top:100%;right:0;left:0;display:flex;flex-direction:column;gap:4px;padding:16px 20px 22px;background:{{ block.settings.scrolled_background_color }};color:{{ block.settings.scrolled_text_color }};box-shadow:0 14px 24px rgba(0,0,0,.08);opacity:0;pointer-events:none;transform:translateY(-8px);transition:opacity 180ms ease,transform 180ms ease}.ai-luxury-header-{{ ai_gen_id }}.menu-open .ai-luxury-header-{{ ai_gen_id }}__mobile-panel{opacity:1;pointer-events:auto;transform:translateY(0)}.ai-luxury-header-{{ ai_gen_id }}__mobile-panel .ai-luxury-header-{{ ai_gen_id }}__link{padding:12px 4px;border-bottom:1px solid rgba(0,0,0,.1)}}@media (prefers-reduced-motion:reduce){.ai-luxury-header-{{ ai_gen_id }},.ai-luxury-header-{{ ai_gen_id }}__link:after,.ai-luxury-header-{{ ai_gen_id }}__mobile-panel{transition:none}}
{% endstyle %}
<luxury-header-{{ ai_gen_id }} class="ai-luxury-header-{{ ai_gen_id }}" data-scroll-threshold="{{ block.settings.scroll_threshold }}" {{ block.shopify_attributes }}><div class="ai-luxury-header-{{ ai_gen_id }}__inner"><button class="ai-luxury-header-{{ ai_gen_id }}__menu-button" type="button" aria-label="Open menu" aria-expanded="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h18M3 12h18M3 17h18"></path></svg></button><a class="ai-luxury-header-{{ ai_gen_id }}__brand" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">{% if block.settings.logo %}<img class="ai-luxury-header-{{ ai_gen_id }}__logo" src="{{ block.settings.logo | image_url: width: 500 }}" alt="{{ block.settings.logo.alt | default: shop.name | escape }}" width="{{ block.settings.logo.width }}" height="{{ block.settings.logo.height }}">{% else %}<span class="ai-luxury-header-{{ ai_gen_id }}__wordmark">{{ block.settings.wordmark | escape }}</span>{% endif %}</a><nav class="ai-luxury-header-{{ ai_gen_id }}__nav" aria-label="Main navigation"><a class="ai-luxury-header-{{ ai_gen_id }}__link" href="{{ block.settings.shop_link | default: routes.all_products_collection_url }}">Shop</a><a class="ai-luxury-header-{{ ai_gen_id }}__link" href="{{ block.settings.shirts_link | default: routes.all_products_collection_url }}">Shirts</a><a class="ai-luxury-header-{{ ai_gen_id }}__link" href="{{ block.settings.suits_link | default: routes.all_products_collection_url }}">Suits</a><a class="ai-luxury-header-{{ ai_gen_id }}__link" href="{{ block.settings.new_arrivals_link | default: routes.all_products_collection_url }}">New arrivals</a><a class="ai-luxury-header-{{ ai_gen_id }}__link" href="{{ block.settings.about_link | default: routes.root_url }}">About</a></nav><div class="ai-luxury-header-{{ ai_gen_id }}__actions"><a class="ai-luxury-header-{{ ai_gen_id }}__icon-link" href="{{ routes.search_url }}" aria-label="Search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"></circle><path d="m16 16 5 5"></path></svg></a><a class="ai-luxury-header-{{ ai_gen_id }}__icon-link" href="{{ routes.cart_url }}" aria-label="Cart, {{ cart.item_count }} items"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h2l1.7 10.2a2 2 0 0 0 2 1.7h7.8a2 2 0 0 0 2-1.7L21 8H7"></path><circle cx="10" cy="20" r="1"></circle><circle cx="18" cy="20" r="1"></circle></svg></a></div></div><nav class="ai-luxury-header-{{ ai_gen_id }}__mobile-panel" aria-label="Mobile navigation"><a class="ai-luxury-header-{{ ai_gen_id }}__link" href="{{ block.settings.shop_link | default: routes.all_products_collection_url }}">Shop</a><a class="ai-luxury-header-{{ ai_gen_id }}__link" href="{{ block.settings.shirts_link | default: routes.all_products_collection_url }}">Shirts</a><a class="ai-luxury-header-{{ ai_gen_id }}__link" href="{{ block.settings.suits_link | default: routes.all_products_collection_url }}">Suits</a><a class="ai-luxury-header-{{ ai_gen_id }}__link" href="{{ block.settings.new_arrivals_link | default: routes.all_products_collection_url }}">New arrivals</a><a class="ai-luxury-header-{{ ai_gen_id }}__link" href="{{ block.settings.about_link | default: routes.root_url }}">About</a></nav></luxury-header-{{ ai_gen_id }}>
<script>(function(){class LuxuryHeader{{ ai_gen_id }} extends HTMLElement{connectedCallback(){this.menuButton=this.querySelector('.ai-luxury-header-{{ ai_gen_id }}__menu-button');this.handleScroll=this.handleScroll.bind(this);this.handleMenu=this.handleMenu.bind(this);window.addEventListener('scroll',this.handleScroll,{passive:true});this.menuButton.addEventListener('click',this.handleMenu);this.handleScroll()}disconnectedCallback(){window.removeEventListener('scroll',this.handleScroll);this.menuButton.removeEventListener('click',this.handleMenu)}handleScroll(){this.classList.toggle('is-scrolled',window.scrollY>Number(this.dataset.scrollThreshold))}handleMenu(){const open=this.classList.toggle('menu-open');this.menuButton.setAttribute('aria-expanded',String(open));this.menuButton.setAttribute('aria-label',open?'Close menu':'Open menu')}}if(!customElements.get('luxury-header-{{ ai_gen_id }}'))customElements.define('luxury-header-{{ ai_gen_id }}',LuxuryHeader{{ ai_gen_id }})})();</script>
{% schema %}{"name":"Luxury transparent header","settings":[{"type":"header","content":"Brand"},{"type":"image_picker","id":"logo","label":"Logo"},{"type":"text","id":"wordmark","label":"Wordmark","default":"Esraa Fashion Designer"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"header_height","label":"Header height","min":56,"max":120,"step":4,"unit":"px","default":80},{"type":"range","id":"mobile_header_height","label":"Mobile height","min":48,"max":88,"step":4,"unit":"px","default":64},{"type":"range","id":"logo_height","label":"Logo height","min":20,"max":70,"step":2,"unit":"px","default":38},{"type":"range","id":"mobile_logo_height","label":"Mobile logo height","min":18,"max":50,"step":2,"unit":"px","default":28},{"type":"header","content":"Navigation"},{"type":"url","id":"shop_link","label":"Shop link"},{"type":"url","id":"shirts_link","label":"Shirts link"},{"type":"url","id":"suits_link","label":"Suits link"},{"type":"url","id":"new_arrivals_link","label":"New arrivals link"},{"type":"url","id":"about_link","label":"About link"},{"type":"header","content":"Typography"},{"type":"font_picker","id":"heading_font","label":"Brand font","default":"inter_n7"},{"type":"font_picker","id":"body_font","label":"Navigation font","default":"inter_n4"},{"type":"range","id":"wordmark_size","label":"Wordmark size","min":10,"max":28,"step":1,"unit":"px","default":16},{"type":"range","id":"mobile_wordmark_size","label":"Mobile wordmark size","min":9,"max":20,"step":1,"unit":"px","default":12},{"type":"range","id":"nav_size","label":"Navigation size","min":10,"max":16,"step":1,"unit":"px","default":11},{"type":"header","content":"Colors"},{"type":"color","id":"overlay_text_color","label":"Overlay text","default":"#FFFFFF"},{"type":"color","id":"scrolled_background_color","label":"Scrolled background","default":"#FFFFFF"},{"type":"color","id":"scrolled_text_color","label":"Scrolled text","default":"#171717"},{"type":"range","id":"scroll_threshold","label":"Scroll threshold","min":0,"max":300,"step":10,"unit":"px","default":40}],"presets":[{"name":"Luxury transparent header"}],"tag":null,"class":"luxury-transparent-header-block"}{% endschema %}