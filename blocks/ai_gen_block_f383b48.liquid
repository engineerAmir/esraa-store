{% doc %}
  @prompt
    Create a luxurious full-width editorial fashion section for “Esraa Fashion Designer”.
    
    This section should highlight embellished, embroidered, sequined, lace, and statement fashion pieces.
    
    Use one large editorial photograph featuring an elegant modest fashion look.
    
    Small label:
    “STATEMENT DRESSING”
    
    Headline:
    “Designed to Make an Impression”
    
    Supporting copy:
    “Embellishment, embroidery, lace, and luminous details come together in statement pieces made for memorable moments.”
    
    CTA:
    “Explore Statement Pieces”
    
    Design:
    
    * Large immersive photography.
    * Elegant rounded outer corners.
    * Minimal dark gradient for text readability.
    * White typography.
    * Premium editorial composition.
    * Subtle image movement or zoom on hover.
    * Fade-up text animation.
    
    Make the image, heading, text, CTA, link, text alignment, overlay strength,
    desktop height, and mobile height editable from the Shopify Theme Editor.
    
    Fully responsive with special attention to mobile image cropping.
{% enddoc %}

{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}

  /* =========================================================
     SECTION
     ========================================================= */

  .ai-editorial-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }


  /* =========================================================
     FRAME
     ========================================================= */

  .ai-editorial-{{ ai_gen_id }}__frame {
    position: relative;

    width: 100%;

    height: {{ block.settings.desktop_height }}px;
    min-height: 0;

    overflow: hidden;

    border-radius: {{ block.settings.corner_radius }}px;

    background: #25211f;

    isolation: isolate;
  }


  /* =========================================================
     MEDIA
     ========================================================= */

  .ai-editorial-{{ ai_gen_id }}__media,
  .ai-editorial-{{ ai_gen_id }}__media img,
  .ai-editorial-{{ ai_gen_id }}__placeholder {
    position: absolute;
    inset: 0;

    width: 100%;
    height: 100%;
  }


  .ai-editorial-{{ ai_gen_id }}__media {
    z-index: -2;
    overflow: hidden;
  }


  .ai-editorial-{{ ai_gen_id }}__media img {
    object-fit: auto;
    object-position: center center;

    transform: scale(1);

    transition:
      transform 1.1s cubic-bezier(.2,.65,.25,1);
  }


  .ai-editorial-{{ ai_gen_id }}__frame:hover
  .ai-editorial-{{ ai_gen_id }}__media img {
    transform: scale(1.045);
  }


  /* =========================================================
     PLACEHOLDER
     ========================================================= */

  .ai-editorial-{{ ai_gen_id }}__placeholder {
    display: flex;

    align-items: center;
    justify-content: center;

    background: #4a403b;
  }


  .ai-editorial-{{ ai_gen_id }}__placeholder svg {
    width: 42%;
    height: 42%;

    color: #d8d0c8;
  }


  /* =========================================================
     OVERLAY
     ========================================================= */

  .ai-editorial-{{ ai_gen_id }}__shade {
    position: absolute;
    inset: 0;

    z-index: -1;

    background:
      linear-gradient(
        90deg,

        rgba(
          12,
          10,
          9,
          {{ block.settings.overlay_strength | divided_by: 100.0 }}
        ) 0%,

        rgba(
          12,
          10,
          9,
          {{ block.settings.overlay_strength | divided_by: 170.0 }}
        ) 55%,

        rgba(12, 10, 9, .08) 100%
      );
  }


  /* =========================================================
     CONTENT
     ========================================================= */

  .ai-editorial-{{ ai_gen_id }}__content {
    position: relative;

    display: flex;
    flex-direction: column;

    justify-content: flex-end;

    align-items:
      {% if block.settings.text_alignment == 'center' %}
        center
      {% elsif block.settings.text_alignment == 'right' %}
        flex-end
      {% else %}
        flex-start
      {% endif %};

    width: 100%;
    height: 100%;
    min-height: 0;

    padding: clamp(28px, 7vw, 88px);

    box-sizing: border-box;

    color: #ffffff;

    text-align: {{ block.settings.text_alignment }};
  }


  .ai-editorial-{{ ai_gen_id }}__copy {
    width: 100%;
    max-width: 690px;

    animation:
      ai-editorial-rise-{{ ai_gen_id }}
      .8s
      ease-out
      both;
  }


  /* =========================================================
     EYEBROW
     ========================================================= */

  .ai-editorial-{{ ai_gen_id }}__eyebrow {
    margin: 0 0 20px;

    color: #ffffff;

    font-size: 11px;
    font-weight: 600;

    letter-spacing: .2em;
    line-height: 1.4;

    text-transform: uppercase;
  }


  /* =========================================================
     HEADING
     ========================================================= */

  .ai-editorial-{{ ai_gen_id }}__heading {
    margin: 0;

    color: #ffffff;

    font-family: inherit;

    font-size: clamp(38px, 6vw, 82px);

    font-weight: 500;

    letter-spacing: -.04em;

    line-height: .98;
  }


  /* =========================================================
     TEXT
     ========================================================= */

  .ai-editorial-{{ ai_gen_id }}__text {
    max-width: 510px;

    margin: 24px 0 32px;

    color: rgba(255, 255, 255, .9);

    font-size: 16px;

    line-height: 1.65;
  }


  /* =========================================================
     CTA
     ========================================================= */

  .ai-editorial-{{ ai_gen_id }}__link {
    display: inline-flex;

    align-items: center;

    gap: 14px;

    padding: 14px 22px;

    border:
      1px solid
      rgba(255, 255, 255, .75);

    border-radius: 14px;

    color: #ffffff;

    font-size: 13px;
    font-weight: 600;

    text-decoration: none;

    transition:
      background-color .25s ease,
      color .25s ease,
      transform .25s ease;
  }


  .ai-editorial-{{ ai_gen_id }}__link:hover {
    background: #ffffff;

    color: #171412;

    transform: translateY(-2px);
  }


  .ai-editorial-{{ ai_gen_id }}__link:focus-visible {
    background: #ffffff;

    color: #171412;

    outline: 2px solid #ffffff;

    outline-offset: 4px;
  }


  /* =========================================================
     ANIMATION
     ========================================================= */

  @keyframes ai-editorial-rise-{{ ai_gen_id }} {

    from {
      opacity: 0;

      transform: translateY(18px);
    }

    to {
      opacity: 1;

      transform: translateY(0);
    }

  }


  /* =========================================================
     TABLET
     ========================================================= */

  @media screen and (min-width: 750px) and (max-width: 1100px) {

    .ai-editorial-{{ ai_gen_id }}__content {
      padding: 48px;
    }

    .ai-editorial-{{ ai_gen_id }}__heading {
      font-size: clamp(42px, 6vw, 68px);
    }

  }


  /* =========================================================
     MOBILE
     ========================================================= */

  @media screen and (max-width: 749px) {

    .ai-editorial-{{ ai_gen_id }} {
      width: 100%;
      max-width: 100%;
    }


    .ai-editorial-{{ ai_gen_id }}__frame {
      height: {{ block.settings.mobile_height }}px;

      min-height: 0;
    }


    .ai-editorial-{{ ai_gen_id }}__content {
      width: 100%;
      height: 100%;

      min-height: 0;

      padding: 28px 22px;
    }


    .ai-editorial-{{ ai_gen_id }}__media img {
      object-position:
        {{ block.settings.mobile_crop }};
    }


    .ai-editorial-{{ ai_gen_id }}__shade {
      background:

        linear-gradient(
          0deg,

          rgba(
            12,
            10,
            9,
            {{ block.settings.overlay_strength | divided_by: 100.0 }}
          ) 0%,

          rgba(
            12,
            10,
            9,
            .12
          ) 75%
        );
    }


    .ai-editorial-{{ ai_gen_id }}__eyebrow {
      margin-bottom: 14px;

      font-size: 9px;
    }


    .ai-editorial-{{ ai_gen_id }}__heading {
      font-size:
        clamp(
          36px,
          11vw,
          58px
        );

      line-height: .98;
    }


    .ai-editorial-{{ ai_gen_id }}__text {
      margin:
        18px
        0
        24px;

      font-size: 15px;

      line-height: 1.55;
    }


    .ai-editorial-{{ ai_gen_id }}__link {
      padding: 13px 18px;

      font-size: 12px;
    }

  }


  /* =========================================================
     SMALL MOBILE
     ========================================================= */

  @media screen and (max-width: 390px) {

    .ai-editorial-{{ ai_gen_id }}__content {
      padding: 22px 18px;
    }


    .ai-editorial-{{ ai_gen_id }}__heading {
      font-size:
        clamp(
          32px,
          10.5vw,
          48px
        );
    }


    .ai-editorial-{{ ai_gen_id }}__text {
      font-size: 14px;
    }

  }


  /* =========================================================
     REDUCED MOTION
     ========================================================= */

  @media (prefers-reduced-motion: reduce) {

    .ai-editorial-{{ ai_gen_id }}__copy {
      animation: none;
    }


    .ai-editorial-{{ ai_gen_id }}__media img {
      transition: none;
    }


    .ai-editorial-{{ ai_gen_id }}__frame:hover
    .ai-editorial-{{ ai_gen_id }}__media img {
      transform: none;
    }

  }

{% endstyle %}


<editorial-fashion-{{ ai_gen_id }}
  class="ai-editorial-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>

  <div class="ai-editorial-{{ ai_gen_id }}__frame">


    <!-- IMAGE -->

    <div class="ai-editorial-{{ ai_gen_id }}__media">

      {% if block.settings.image %}

        <img
          src="{{ block.settings.image | image_url: width: 2400 }}"

          srcset="
            {{ block.settings.image | image_url: width: 750 }} 750w,
            {{ block.settings.image | image_url: width: 1200 }} 1200w,
            {{ block.settings.image | image_url: width: 1600 }} 1600w,
            {{ block.settings.image | image_url: width: 2000 }} 2000w,
            {{ block.settings.image | image_url: width: 2400 }} 2400w
          "

          sizes="100vw"

          alt="{{ block.settings.image.alt | default: block.settings.heading | escape }}"

          loading="lazy"

          width="{{ block.settings.image.width }}"
          height="{{ block.settings.image.height }}"
        >

      {% else %}

        <div class="ai-editorial-{{ ai_gen_id }}__placeholder">

          {{ 'hero-apparel-1' | placeholder_svg_tag }}

        </div>

      {% endif %}

    </div>


    <!-- OVERLAY -->

    <div
      class="ai-editorial-{{ ai_gen_id }}__shade"
      aria-hidden="true"
    ></div>


    <!-- CONTENT -->

    <div class="ai-editorial-{{ ai_gen_id }}__content">

      <div class="ai-editorial-{{ ai_gen_id }}__copy">


        {% if block.settings.label != blank %}

          <p class="ai-editorial-{{ ai_gen_id }}__eyebrow">

            {{ block.settings.label }}

          </p>

        {% endif %}


        {% if block.settings.heading != blank %}

          <h2 class="ai-editorial-{{ ai_gen_id }}__heading">

            {{ block.settings.heading }}

          </h2>

        {% endif %}


        {% if block.settings.copy != blank %}

          <div class="ai-editorial-{{ ai_gen_id }}__text">

            {{ block.settings.copy | escape | newline_to_br }}

          </div>

        {% endif %}


        {% if block.settings.cta_label != blank and block.settings.cta_link != blank %}

          <a
            class="ai-editorial-{{ ai_gen_id }}__link"
            href="{{ block.settings.cta_link }}"
          >

            {{ block.settings.cta_label }}

            <span aria-hidden="true">
              ↗
            </span>

          </a>

        {% endif %}


      </div>

    </div>


  </div>

</editorial-fashion-{{ ai_gen_id }}>


{% schema %}
{
  "name": "Editorial fashion",

  "settings": [

    {
      "type": "header",
      "content": "Content"
    },

    {
      "type": "image_picker",
      "id": "image",
      "label": "Editorial image"
    },

    {
      "type": "text",
      "id": "label",
      "label": "Small label",
      "default": "STATEMENT DRESSING"
    },

    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Designed to Make an Impression"
    },

    {
      "type": "textarea",
      "id": "copy",
      "label": "Supporting copy",
      "default": "Embellishment, embroidery, lace, and luminous details come together in statement pieces made for memorable moments."
    },

    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "Explore Statement Pieces"
    },

    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    },


    {
      "type": "header",
      "content": "Section size"
    },

    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },

    {
      "type": "range",
      "id": "desktop_height",
      "label": "Desktop height",
      "min": 400,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 680
    },

    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile height",
      "min": 400,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "default": 620
    },


    {
      "type": "header",
      "content": "Layout"
    },

    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",

      "options": [

        {
          "value": "left",
          "label": "Left"
        },

        {
          "value": "center",
          "label": "Center"
        },

        {
          "value": "right",
          "label": "Right"
        }

      ],

      "default": "left"
    },


    {
      "type": "select",
      "id": "mobile_crop",
      "label": "Mobile image position",

      "options": [

        {
          "value": "left center",
          "label": "Left"
        },

        {
          "value": "center center",
          "label": "Center"
        },

        {
          "value": "right center",
          "label": "Right"
        },

        {
          "value": "center top",
          "label": "Top"
        },

        {
          "value": "center bottom",
          "label": "Bottom"
        }

      ],

      "default": "center center"
    },


    {
      "type": "header",
      "content": "Appearance"
    },

    {
      "type": "range",
      "id": "overlay_strength",
      "label": "Overlay strength",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 55
    },

    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 18
    }

  ],

  "presets": [
    {
      "name": "Editorial fashion"
    }
  ],

  "tag": null,

  "class": "editorial-fashion-block"
}
{% endschema %}