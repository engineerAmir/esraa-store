{% if settings.framework_shipping and settings.framework_shipping_threshold > 0 %}
  {% liquid
    assign threshold = settings.framework_shipping_threshold | times: 100 | round
    assign remaining = threshold | minus: cart.total_price
    assign progress = cart.total_price | times: 100.0 | divided_by: threshold | at_most: 100
    assign remaining_money = remaining | money_with_currency
  %}
  <div class="framework-shipping" role="status">
    <p id="FrameworkShippingMessage">
      {% if remaining > 0 %}
        {{ 'framework.shipping.remaining' | t: amount: remaining_money }}
      {% else %}
        {{ 'framework.shipping.unlocked' | t }}
      {% endif %}
    </p>
    <progress max="100" value="{{ progress }}" aria-labelledby="FrameworkShippingMessage">{{ progress | round }}%</progress>
  </div>
{% endif %}
